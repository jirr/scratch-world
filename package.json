{
  "name": "scratch-world",
  "version": "0.1.1",
  "private": true,
  "description": "PWA carte du monde à gratter (local-first)",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:e2e-next": "BUILD_SHA=e2e-next vite build --outDir dist-next",
    "build:bench": "vite build --mode bench --outDir dist-bench",
    "preview": "vite preview --port 4173 --strictPort",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && svelte-check --fail-on-warnings",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "e2e": "playwright test",
    "bench:fog": "PW_PERF=1 playwright test --project=perf",
    "screenshots": "playwright test --project=screenshots",
    "gen:fixtures": "tsx scripts/gen-fixtures.ts",
    "gen:cells": "tsx scripts/gen-cells.ts",
    "build:countries": "tsx scripts/build-countries.ts",
    "build:france": "tsx scripts/build-france.ts"
  },
  "dependencies": {
    "@tmcw/togeojson": "^7.1.3",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "@xmldom/xmldom": "^0.9.12",
    "comlink": "^4.4.2",
    "dexie": "^4.4.7",
    "flatbush": "^4.6.2",
    "h3-js": "^4.5.0",
    "maplibre-gl": "^6.16.0",
    "svelte": "^5.57.3",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@turf/area": "^7.4.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.5",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.7.7",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
